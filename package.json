{
  "name": "daymark",
  "version": "0.1.0",
  "private": true,
  "description": "A private, consentful Gemini-powered reflection journal for Cloud Run.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10 <12"
  },
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc --project tsconfig.server.build.json",
    "dev": "tsx watch src/server/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:dependencies": "knip --production",
    "lint:duplication": "jscpd --config .jscpd.json",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "start": "node dist/server/index.js",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore --project daymark-test --config firebase.json \"vitest run --config vitest.rules.config.ts\"",
    "test:smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --build --pretty false"
  },
  "dependencies": {
    "@google/genai": "2.21.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/themes": "3.3.0",
    "compression": "1.8.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "firebase": "12.18.0",
    "firebase-admin": "14.3.0",
    "helmet": "8.3.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsdoc": "63.3.3",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.9.0",
    "firebase-tools": "15.29.0",
    "globals": "17.12.0",
    "jscpd": "5.1.2",
    "jsdom": "29.1.1",
    "knip": "6.34.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "gaxios": {
      "uuid": "11.1.1"
    },
    "qs": "6.16.0",
    "re2": "1.26.1",
    "teeny-request": {
      "uuid": "11.1.1"
    }
  }
}
